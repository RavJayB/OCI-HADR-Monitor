# Copy to .env and fill in. .env is gitignored — never commit it.
#
#   cp .env.example .env
#   docker run --env-file .env -p 5050:5000 hadr-monitor

# ADMIN password for your Autonomous Database.
DB_PASSWORD=your-admin-password

# Password you chose when downloading the wallet from the OCI console.
WALLET_PASSWORD=your-wallet-password

# TNS alias from your wallet's tnsnames.ora (e.g. mydb_tp, mydb_high).
DB_DSN=hadrdemo_tp

# Optional.
# DB_USER=ADMIN
# PROBE_INTERVAL=1.0
# SLA_TARGET_S=120
