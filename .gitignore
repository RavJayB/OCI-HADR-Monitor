# ---------------------------------------------------------------------------
# CREDENTIALS — never commit these.
#
# An Oracle wallet is a working credential. Anyone holding cwallet.sso (or
# ewallet.p12 plus its password) can connect to the database as ADMIN. Keep
# wallets out of git even in a private repo.
# ---------------------------------------------------------------------------
wallet/*
!wallet/.gitkeep
Wallet_*/
*.zip
cwallet.sso
ewallet.p12
ewallet.pem
keystore.jks
truststore.jks
ojdbc.properties
sqlnet.ora
tnsnames.ora

# Environment files hold DB_PASSWORD / WALLET_PASSWORD.
.env
.env.*
!.env.example

# Local run output.
switchover_evidence.json

# macOS
.DS_Store
